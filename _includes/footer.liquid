{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
  <br>
  <span id="busuanzi_container_site_pv" style="display: none; font-size: 0.85rem; font-variant-numeric: tabular-nums;" aria-live="polite">
    Total Views: <span id="busuanzi_site_pv"></span> &nbsp;|&nbsp;
    Visitors: <span id="busuanzi_site_uv"></span>
  </span>
  <script defer src="https://cdn.jsdelivr.net/npm/penndu@17.0.0/bsz.js"></script>
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
